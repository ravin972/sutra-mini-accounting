FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/api ./cmd/api

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /bin/api /app/api
COPY migrations /app/migrations
EXPOSE 8080
CMD ["/app/api"]
